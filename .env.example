APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brookstone_portal_db
DB_USERNAME=root
DB_PASSWORD=

# The automated test suite runs on MySQL against a dedicated database.
# Create it once: CREATE DATABASE portal_testing;
# (phpunit.xml pins DB_DATABASE=portal_testing; a guard refuses any non-test DB.)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,localhost:5173


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated addresses pushed a copy of a FAILING scheduled detector (routes/console.php).
# Empty is a supported state, not a misconfiguration: with none set, the Log::error stays the channel.
MONITORING_ALERT_RECIPIENTS=

# OVERRIDE, NOT THE SOURCE — and LEFT COMMENTED OUT ON PURPOSE. The models that throw
# MissingSchoolContextException on a read with no active School are a versioned default in
# config/rbac.php, so an environment that sets nothing gets the whole batch. Setting this REPLACES
# the default wholesale rather than adding to it: it is a per-environment retreat from a protection
# the repository already ships, and it wants a reason. Blank is read as "not set" precisely so that
# copying this file cannot switch the batch off by accident.
# RBAC_FAIL_CLOSED_MODELS="App\Finance\Models\Invoice,App\Finance\Models\Payment"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── SES + SNS bounce loop (notifications) ────────────────────────────────────
# Four values, and THREE OF THEM FAIL SILENTLY if wrong — mail still sends, no
# events ever arrive, and the suppression table stays empty while looking healthy.
#
# 1. The mailer itself. Anything other than a live SES mailer means no SES events.
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
#
# 2. The configuration set NAMED on every outbound message. SES publishes bounce
#    and complaint events ONLY for mail sent under a config set that has an SNS
#    event destination. Unset, sending works perfectly and emits nothing — the
#    silent one.
# AWS_SES_CONFIGURATION_SET=
#
# 3. The SNS topic the bounce endpoint will accept. This is the LOUD one: the
#    endpoint fails CLOSED and 403s every message until it is set. MessageValidator
#    proves a message was signed by AWS; only this proves it came from OUR topic,
#    without which a forged bounce can permanently suppress a named guardian.
# AWS_SES_SNS_TOPIC_ARN=

# Paystack — the payment gateway. The SECRET key is also the webhook verification key:
# Paystack signs each webhook with HMAC-SHA512 over the raw body using this same value, so it is
# both our API credential and our forgery check. Leave BLANK here; real values live in .env only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FINANCE_GATEWAY_MINIMUM_PART_PAYMENT_MINOR=
