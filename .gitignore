# Claude Code — PER-USER / runtime state, never shared.
# settings.local.json holds one machine's permission allowlist (it has carried
# absolute /Users/<name>/... paths) and conflicted on every cross-machine merge;
# scheduled_tasks.lock is runtime state. Shared Claude config (.claude/settings.json,
# agents/, skills/, commands/) stays tracked — only these two are ignored.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local drive-fixture environment (secrets copied from .env — never commit)
.env.drive

# Boundary-lint coverage fixtures (tests/Arch/BoundaryLintCoverageTest.php plants
# these into the real tree and removes them in a finally). The finally covers a
# thrown exception; it does not cover a SIGKILL or a crashed host, and the residue
# of those is an UNTRACKED file — committable, and the one consequence that
# outlives the run.
app/Finance/BoundaryLintFixture*.php
