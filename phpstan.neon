includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Level 5 is the FIXED Phase-1 enforcement level (§17.3). Do not raise it in
    # this milestone. Pre-existing findings are frozen in phpstan-baseline.neon
    # (the same ratchet pattern as tests/tsc/authz/boundary); the gate fails only
    # on NEW findings, and the baseline may only shrink.
    level: 5
    paths:
        - app

    # Result cache, REPO-LOCAL and gitignored. The default is sys_get_temp_dir()/phpstan,
    # which is shared by every checkout and every branch on the machine and is invisible to
    # anyone debugging a wrong answer — a stale entry there reported 8 hard failures against
    # a vendor/ that was merely incomplete, and survived the `composer install` that fixed
    # the tree. Per-checkout makes it inspectable and scopes a bad cache to one worktree.
    #
    # It is NOT cleared every run — the result cache is the only reason `composer analyse`
    # is bearable in bin/quality. It is cleared exactly when the input it cannot see has
    # moved: bin/ci-dependency-integrity-lint.php drops it when composer.lock's sha256
    # differs from build/phpstan.lock-fingerprint. bin/quality-promote clears it outright.
    tmpDir: build/phpstan
