#!/usr/bin/env bash
#
# Pre-push quality gate — the PERMANENT enforcement floor.
#
# GitHub Actions is intentionally disabled (billing not pursued), so there is no
# remote CI and no required status checks. This hook and bin/quality ARE the floor,
# by design — not a stopgap waiting for CI to come back.
#
# A quality check you must remember to run is not a gate. This makes bin/quality an
# accident-floor: you cannot push past a regression by forgetting.
#
# Pushing to `main` is a RELEASE and needs more: per-branch green is not
# merged-result green, so main additionally requires a passing release gate
# (bin/quality-promote) stamped with the exact commit being pushed.
#
# HONEST LIMIT: this guards against FORGETTING, not INTENT. `--no-verify` bypasses
# it, deliberately — a floor that can trap you is worse than one you can step over
# on purpose. Treat a bypass as a recorded decision, never a routine.
#
# See CLAUDE.md § Workflow for what this floor does and does not prove.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
z40=0000000000000000000000000000000000000000

# git feeds the ref list on stdin ONCE — read it all up front, then inspect it as
# many times as needed. (Reading stdin twice silently yields nothing the second
# time, which would have made the main-branch check below a no-op.)
refs="$(cat)"

# Branch deletes carry an all-zero local sha and have nothing to verify.
gated=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$z40" ] || gated=1
done <<EOF
$refs
EOF
[ "$gated" = "1" ] || exit 0

# Release gate: a push to main must carry a stamp matching that exact commit.
while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -n "${remote_ref:-}" ] || continue
    [ "$local_sha" = "$z40" ] && continue
    case "$remote_ref" in
        refs/heads/main)
            stamp="$repo_root/.quality-promote-ok"
            if [ ! -f "$stamp" ] || [ "$(cat "$stamp" 2>/dev/null)" != "$local_sha" ]; then
                printf '\033[31mpush to main blocked:\033[0m no release-gate pass for %s\n' "${local_sha:0:8}"
                printf 'Verify staging first (verify-then-promote):\n'
                printf '  git checkout staging && bin/quality-promote\n'
                printf '  git checkout main && git merge --ff-only staging && git push\n'
                # --ff-only is not a style preference: the stamp names the EXACT SHA
                # that was verified, so any merge that mints a NEW commit (a --no-ff
                # merge, or a real merge because main has drifted) can never match it.
                # Saying "merge staging into main" without qualification invites
                # `--no-ff`, which is a common release habit and blocks here every
                # time. --ff-only instead fails loudly when a fast-forward is not
                # possible, which is the signal that main has diverged and needs a
                # human, rather than silently producing an unverifiable commit.
                printf 'The merge must FAST-FORWARD: the stamp names one exact commit, so a\n'
                printf 'merge commit (--no-ff) can never match it. (Bypass: --no-verify, recorded as intent.)\n'
                exit 1
            fi
            printf '\033[32mpre-push:\033[0m release gate verified for %s\n' "${local_sha:0:8}"
            ;;
    esac
done <<EOF
$refs
EOF

# --------------------------------------------------------------------------------------
# DOCS-ONLY PUSH — the one case where the gate does not run.
#
# Two commits on feat/u7-supplementary-invoice-wire (7237ad3, 8570a0b) changed nothing but
# prose and screenshots under docs/ and each paid the full fifteen steps, the suite included.
# This is the only place that can decide that, because this is the only place that knows the
# push RANGE: git names the base on stdin as <remote_sha>.
#
# THE DECISION IS NOT HERE. bin/is-docs-only-push owns it, so that it can be planted against
# real repositories and shown to refuse — see tests/Feature/Quality/DocsOnlyPushCoverageTest.php.
# bin/quality is not touched by any of this: it still means "run everything", for a manual run
# and for bin/quality-promote.
#
# EVERY NON-ZERO EXIT FROM THE CHECKER RUNS THE FULL GATE — "not documentation" and "could not
# work out the range" are collapsed here on purpose. The safe direction is always to run
# everything, so an unanswerable question must never become a skip. A checker that is missing
# or not executable (an older checkout, a partial clone) is treated the same way.
#
# refs/heads/main IS EXCLUDED OUTRIGHT, before the checker is even consulted. That path is the
# release gate and the quality-promote stamp above; a docs-only release is still a release.
#
# ONE NON-DOCS REF POISONS THE WHOLE PUSH. git can send several refs on one stdin and they land
# together; skipping because three of four ranges were prose would leave the fourth ungated.
docs_only=1
docs_files=""
docs_ranges=""
checker="$repo_root/bin/is-docs-only-push"
[ -x "$checker" ] || docs_only=0

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$z40" ] && continue
    [ "$docs_only" = "1" ] || continue
    case "${remote_ref:-}" in
        refs/heads/main) docs_only=0; continue ;;
    esac
    # The checker prints the paths it judged; printing THOSE, rather than re-deriving the list
    # here, is what stops the displayed files from ever disagreeing with the verdict.
    if changed="$("$checker" "${remote_sha:-}" "$local_sha" 2>/dev/null)"; then
        docs_files="${docs_files}${changed}
"
        docs_ranges="${docs_ranges}    ${remote_sha:0:8}..${local_sha:0:8}  ${remote_ref:-?}
"
    else
        docs_only=0
    fi
done <<EOF
$refs
EOF

if [ "$docs_only" = "1" ]; then
    # A SKIPPED GREEN MUST NOT LOOK LIKE A FULL GREEN. This is the whole risk of the change:
    # someone scrolling back a week later has to be able to tell which kind of green they are
    # reading. So this says what it did and why, names every file, and deliberately shares no
    # wording with bin/quality's success line ("✓ quality: PASS — per-push floor…"). Grepping a
    # terminal for that sentence will never find this one.
    printf '\033[1;33mpre-push: DOCS-ONLY PUSH — bin/quality was NOT RUN.\033[0m\n'
    printf 'Every file changed in this push is under docs/:\n'
    printf '%s' "$docs_files" | sed 's/^/    /'
    printf '  range(s) examined:\n%s' "$docs_ranges"
    printf '\033[2m  Nothing was verified. No test, lint, type-check, arch rule or Larastan run\n'
    printf '  measured this push — this is a SKIP, not a quality result. The next push that\n'
    printf '  touches any file outside docs/ runs the full gate over everything since the base.\033[0m\n'
    exit 0
fi

printf '\033[1mpre-push:\033[0m running bin/quality (local is the enforcement floor)\n'

if "$repo_root/bin/quality"; then
    exit 0
fi

printf '\n\033[31mpush blocked by the local quality gate.\033[0m\n'
printf 'Fix the failures above, or bypass deliberately: git push --no-verify\n'
exit 1
