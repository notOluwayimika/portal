#!/usr/bin/env bash
#
# Local quality gate — the PERMANENT definition of "green" for a per-push change.
#
# GitHub Actions is intentionally disabled and has never executed a job here. This is
# the floor by design, not a stopgap. Two things stand alongside it:
# bin/quality-clean-db (throwaway DB, migrate-from-zero, data, rollback/re-up) and
# bin/quality-promote (the staging -> main release gate, which runs both).
#
# This mirrors the CI jobs step for step so that "local green" means exactly what
# "CI green" would mean. If you change .github/workflows/{lint,tests}.yml, change
# this too — a fork between the two re-creates the bug that started the tsc saga,
# where CI and a developer measured different trees and both reported green.
#
#   lint.yml (job: quality)          -> steps 2..15 below
#   tests.yml (job: ci)              -> step 16 below
#   (neither workflow)               -> step 17, the JavaScript tests
#
# (The numbers above are re-derived, not carried: the step count is 17 as of the vitest
# step. They were already one behind at 12 steps, then 13, then 14, then 15, then 16.)
#
# STEP 17 MIRRORS NOTHING, and that is not a fork of the kind the paragraph above warns
# about. Neither workflow has a JavaScript test job because until this step landed the
# repository had no JavaScript test runner at all (the ticket:
# docs/handoff/tickets/no-javascript-test-runner.md). There is no CI counterpart to drift
# from — Actions has never executed a job here and is not being restored (ADR 0053).
#
# STEP 1 IS THE ONE EXCEPTION TO THE MIRROR, and deliberately: CI runs `composer install`
# in the job immediately before, so a lock-vs-vendor check there is vacuous by construction.
# It has meaning only on a working copy someone has been merging into. (lint.yml is in any
# case already behind this script by two lints — Actions has never executed a job here.)
#
# DELIBERATELY OMITTED, and why — these are environment PROVISIONING, not gates:
#   composer install / pnpm install  - your working copy already has them; this
#                                      script verifies vendor/ MATCHES composer.lock
#                                      instead (step 1). It used to verify only that
#                                      the directory existed, which is not the same
#                                      claim and is how a wrong tree got measured.
#   cp .env.example .env             - would clobber your real local .env.
#   php artisan key:generate         - CI runs it on a throwaway .env copy. Locally
#                                      it would ROTATE your APP_KEY and can render
#                                      existing encrypted data unreadable. Never here.
#   php artisan migrate --force      - CI migrates a fresh service DB; locally the
#                                      suite's RefreshDatabase migrates per run, so
#                                      a broken migration still fails step 16. (This
#                                      read "step 11" and was already two behind; the
#                                      suite is the last step, whatever its number.)
#   pnpm run build                   - asset compilation, not a quality signal. The
#                                      wayfinder generation it would perform IS
#                                      needed, and is done explicitly in step 2.
#
# Usage: bin/quality            (base auto-detected: merge-base with origin/staging)
#        bin/quality <base-ref>
#
# Exit code is the gate: 0 = push allowed, non-zero = blocked.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 2

RED=$'\033[31m'; GREEN=$'\033[32m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; OFF=$'\033[0m'
FAILED=()
STEP=0

step() {
    STEP=$((STEP + 1))
    printf '%s[%d/18]%s %s\n' "$BOLD" "$STEP" "$OFF" "$1"
}

# Run a command; record failure but keep going so one push surfaces every problem
# rather than one-at-a-time. (CI stops at the first failing step; collecting them
# locally is strictly more useful and cannot make the gate weaker — any failure
# still fails the whole run.)
#
# THAT ARGUMENT HOLDS FOR A DETECTOR, AND ONLY FOR A DETECTOR. Steps 2-17 each measure a
# property of the code. Step 1 measures whether the code being measured is the code that
# was declared. When step 1 is red the later steps are not extra findings — they are
# readings from an instrument that has just reported itself untrustworthy, and fourteen
# green ticks printed beside one red line tell the reader the opposite of the truth. So
# step 1 alone uses abort_check() and exits 2, which is the severity the `[ -d vendor ]`
# precondition it replaced always had; moving it into check() would have quietly demoted
# a hard precondition to a soft finding. Do NOT "fix" that inconsistency by making step 1
# collect like the others — the inconsistency is the point.
check() {
    local label="$1"; shift
    if "$@" >/tmp/quality-step.log 2>&1; then
        printf '   %s✓%s %s\n' "$GREEN" "$OFF" "$label"

        # SAY WHAT A GREEN ACTUALLY CHECKED, for the one step that can legitimately check NOTHING.
        #
        # bin/lint-changed.sh reads `git diff "$BASE"...HEAD` — three dots, against HEAD — so it
        # sees COMMITTED changes only. Uncommitted work is invisible to it, and on a branch with
        # nothing committed yet it lints zero files and passes. That green is indistinguishable
        # from one that linted everything, and it shipped: a bare run passed having linted 0 files,
        # then the pre-push hook (whose $BASE is origin/staging, with the work by then committed)
        # failed on 9.
        #
        # Zero is NOT an error — a docs-only change legitimately lints nothing — so this reports
        # rather than fails. The silence was the defect, not the zero.
        #
        # grep -o rather than a line-anchored sed: Pint prints its JSON without a trailing newline,
        # so the next heading is concatenated onto it and an anchored match silently drops it —
        # which would have hidden the Prettier count, the very thing this exists to show.
        if [ "$label" = "lint-changed" ]; then
            grep -o '==> [^{]*' /tmp/quality-step.log | sed 's/^==> /       /'
        fi
    else
        printf '   %s✗%s %s\n' "$RED" "$OFF" "$label"
        sed 's/^/       /' /tmp/quality-step.log | tail -25
        FAILED+=("$label")
    fi
}

# Step 1 only — see check()'s note above. Same output shape, then stops the run: exit 2,
# not 1, to keep it distinguishable from "the gate found problems". Either blocks a push
# (.githooks/pre-push:74 treats any non-zero the same), so nothing is weakened by it.
abort_check() {
    local label="$1"; shift
    if "$@" >/tmp/quality-step.log 2>&1; then
        printf '   %s✓%s %s\n' "$GREEN" "$OFF" "$label"
        return 0
    fi
    printf '   %s✗%s %s\n' "$RED" "$OFF" "$label"
    sed 's/^/       /' /tmp/quality-step.log | tail -25
    printf '\n%s✗ quality: ABORTED at step %d%s — the working tree does not match what was declared.\n' "$RED" "$STEP" "$OFF"
    printf '%sThe remaining steps would measure the wrong tree, so they were not run. Fix the above and re-run.%s\n' "$DIM" "$OFF"
    exit 2
}

# ---------------------------------------------------------------- preconditions
# EXISTENCE ONLY — "can this script bootstrap at all", NOT "are the dependencies right".
# `[ -d vendor ]` used to be the whole dependency check and it cannot carry that: a
# vendor/ that exists but is behind composer.lock passes it, and every step after runs
# against a tree nobody declared. Integrity is step 1 below, which is a real check.
# node_modules has no integrity check yet — same known limit, see step 1's header.
[ -f vendor/autoload.php ] || { echo "${RED}vendor/ missing — run: composer install${OFF}"; exit 2; }
[ -d node_modules ] || { echo "${RED}node_modules/ missing — run: pnpm install${OFF}"; exit 2; }

# The base commit for the changed-files lint, mirroring lint.yml's "Determine base
# commit": a PR compares against its base branch; we compare against the merge-base
# with origin/staging (falling back to origin/main, then HEAD~1).
BASE="${1:-}"
if [ -z "$BASE" ]; then
    for ref in origin/staging origin/main; do
        if git rev-parse --verify --quiet "$ref" >/dev/null; then
            BASE="$(git merge-base HEAD "$ref" 2>/dev/null)" && [ -n "$BASE" ] && break
        fi
    done
    [ -n "$BASE" ] || BASE="$(git rev-parse HEAD~1 2>/dev/null || echo HEAD)"
fi
printf '%squality gate — base %s%s\n\n' "$DIM" "$(git rev-parse --short "$BASE" 2>/dev/null || echo "$BASE")" "$OFF"

# 1. Dependency integrity BEFORE ANYTHING ELSE. Every step below measures a tree, and
#    a tree that does not match composer.lock makes all sixteen answers meaningless —
#    in whichever direction. It also reconciles step 15's phpstan result cache against
#    composer.lock, because that cache cannot see vendor/ moving underneath it. Full
#    reasoning, and the two failure cases, in the lint's header.
#
#    BOTH NUMBERS ABOVE WERE WRONG. "fifteen" was correct at 16 steps and was broken by
#    the vitest step; "step 14" named the arch tests and had been stale since before it —
#    Larastan has been step 15 for longer than this comment has said 14. Same class as the
#    step counts in format.ts and the money lint: prose stating a number that nothing can
#    fail on. QualityStepCountTest ties the printf to the step() calls and nothing ties
#    these; the docblock there says outright that this half stays unmechanised.
#
#    ABORTS the run rather than collecting — abort_check(), not check(). See check()'s
#    comment for why this one step is the exception.
step "dependency integrity (composer.lock vs composer.json vs vendor/)"
abort_check "dependency-integrity-lint" php bin/ci-dependency-integrity-lint.php

# 2. Wayfinder EARLY. resources/js/{routes,actions} are generated from the PHP
#    routes and gitignored; without this, tsc measures a stale or absent tree and
#    the ratchet compares against a number that means nothing. This ordering is the
#    fix from the tsc slice — do not move it below the tsc ratchet (step 4). Named, not
#    numbered, because the number has already shifted once.
#
#    --with-form IS REQUIRED and must match vite.config.ts's `wayfinder({
#    formVariants: true })`. Without it the generator omits every `.form` helper, so
#    this step OVERWRITES the dev server's correct output with a build the app cannot
#    run: 11 files call `.form()`, and the login page renders blank. It is not a
#    harmless difference — it is a different codebase, and the tsc baseline was
#    calibrated against it, which is how a blank login page sat inside a green
#    ratchet. If you change the flag here, change vite.config.ts and lint.yml too.
step "wayfinder:generate --with-form (must match vite.config.ts formVariants)"
check "wayfinder:generate" php artisan wayfinder:generate --with-form

# 3. Pint / Prettier / ESLint — CHECK MODE, CHANGED FILES ONLY.
#    Never a directory glob: globbing has silently reformatted ~12 unrelated legacy
#    files twice in this project. bin/lint-changed.sh is the only sanctioned entry
#    point, and it is what CI runs.
step "lint changed files (Pint / Prettier / ESLint, check mode)"
check "lint-changed" bash bin/lint-changed.sh "$BASE"

# 4. tsc ratchet — pest/tsc may exit non-zero; the RATCHET script is the gate.
step "types (tsc ratchet vs tsc-baseline)"
pnpm run types:check >/tmp/quality-tsc.txt 2>&1 || true
check "tsc-ratchet" php bin/ci-tsc-ratchet.php /tmp/quality-tsc.txt

# 5. Frontend build. The tsc ratchet CANNOT stand in for this: a syntax error that
#    stops a file parsing is not a TYPE error, so the ratchet counts it as zero and
#    stays at baseline while the bundle refuses to build. That is not theoretical —
#    merging #162 into a staging already carrying #160 interleaved two JSX blocks and
#    dropped a `/>` and `)}`; all eleven previous gates passed on a tree whose
#    frontend did not compile, and it was found by a human running `npm run build`.
#
#    NOT ratcheted and NOT a changed-files check: a bundle either builds or it does
#    not, there is no baseline to be behind, and a break can live in a file the diff
#    never touched — which is exactly how the merge artifact arose.
step "frontend build (vite — catches what the tsc ratchet structurally cannot)"
check "build" pnpm run build

step "authorization guard (no new commented-out checks)"
check "authz-lint" php bin/ci-authz-lint.php

step "boundary lint (§17.2)"
check "boundary-lint" php bin/ci-boundary-lint.php

# dev-namespace lint. STATE-BASED and NO BASELINE: the population was measured at exactly one before
# the rule landed, and that one is fixed in the same change — a rule that ships red hands the next
# person a cleanup and invites the baselining it exists to prevent.
#
# It sits beside boundary-lint because it enforces the same KIND of thing: a dependency across a line
# the codebase draws. The line here is composer.json's own autoload vs autoload-dev split, and both
# sides are DERIVED from that file rather than hardcoded, so a second dev-only namespace added later
# is covered without anyone remembering this step exists.
#
# Before this, the only thing that reacted to a `use Tests\…;` in app/ was the arch pass — and it
# reacted by exiting 255 with ZERO output on every stream, because the fatal sat in an unflushed
# output buffer. That is not enforcement; it is a control that dies quietly and costs a bisect.
step "dev-namespace lint (no autoload-dev import from a production path)"
check "dev-namespace-lint" php bin/ci-dev-namespace-lint.php

# grants-convergence lint. DIFF-AWARE, and it takes "$BASE" the way lint-changed does at :102 —
# because this invariant CANNOT be asserted from state. CI's database is freshly seeded, and on a
# fresh seed RbacSeeder::grantsMap() always matches the database by construction ($existingRoles is
# empty, so every role takes the `: $permissions` branch at RbacSeeder.php:494-496). The live
# production copy is the only witness and no gate has it. So the diff is the only place a
# pre-existing-permission-added-to-a-pre-existing-role grant is visible.
#
# IT IS THEREFORE NOT RETROACTIVE — a green here says nothing about grants that have ALREADY
# drifted. That half is `php artisan rbac:diff-grants`, run against a real database by an operator.
step "grants-convergence lint (a pre-existing permission added to grantsMap() ships a migration)"
check "grants-convergence-lint" php bin/ci-grants-convergence-lint.php "$BASE"

step "money lint (UI: formatNaira, no JS money math | server: Money::format(), no number_format on money)"
check "money-lint" php bin/ci-money-lint.php

step "runtime-zero lint (S7 legacy access sources)"
check "runtime-zero-lint" php bin/ci-runtime-zero-lint.php

step "identifier-generation bypass guard (1.4b)"
check "identifier-generation-lint" php bin/ci-identifier-generation-lint.php

# 12. sql-clock lint. MySQL's clock is a different FRAME from the application's — the server's
#     session zone is not app.timezone and on the shared production host it cannot be made to be
#     (+05:30, not ours to set). A value NOW() produces is stored true and read back offset, while
#     every timestamp Laravel writes is stored offset and read back true, so one SQL-side clock
#     read puts two frames in one table. That shipped in the single writer of the money projection
#     and put `last_activity` 5.5 hours in the future on the bursar's accounts index.
#
#     ADDED AT ZERO, which is the only moment a rule like this is free: the two occurrences it
#     would have failed on are removed in the same commit, and the one historical exception is
#     named in the lint with its reason. See docs/handoff/tickets/stored-epoch-offset.md.
step "sql-clock lint (no MySQL clock functions in raw SQL — two frames, one table)"
check "sql-clock-lint" php bin/ci-sql-clock-lint.php

# 13. citation lint. STATE-BASED, not diff-aware, and that is the choice the baseline makes for
#     us: the history is IN the baseline, so the whole tree can be re-asserted on every run and a
#     citation that goes stale because a DIFFERENT branch moved its target fails on that branch,
#     which is the case a diff-aware rule structurally cannot see (the citing file is untouched,
#     so nothing about it is in the diff). A diff-aware version would also have to re-derive what
#     "new" means on every rebase; a shrink-only baseline does not.
#
#     NOT ADDED AT ZERO, unlike the sql-clock lint — 180 citations in the scanned dirs predate the
#     rule and are baselined. The rule is therefore about the NEXT citation, which is the one the
#     ticket has watched go wrong six times across four branches.
step "citation lint (a new path:LINE citation names a symbol, and the symbol is there)"
check "citation-lint" php bin/ci-citation-lint.php

step "architecture tests (§17.1)"
check "arch" env DB_DATABASE=portal_testing ./vendor/bin/pest --group=arch

step "static analysis (Larastan level 5 vs baseline)"
# CALLED DIRECTLY, NOT THROUGH `composer analyse` — Composer imposes a 300-second process
# timeout on every script it runs. That is Composer's built-in default, not ours: nothing
# in composer.json's `config` block sets it, the global config is empty, and
# `composer config process-timeout` reports 300. A COLD analysis of app/ takes longer than
# that, so the step was killed mid-run and reported red:
#
#   The following exception is caused by a process timeout
#   [Symfony\Component\Process\Exception\ProcessTimedOutException]
#   The process "phpstan analyse --no-progress --memory-limit=1G" exceeded the timeout of 300 seconds.
#
# Measured on this tree: warm 3s; cold, called directly, 1107s and 0 errors; cold through
# Composer, killed at 303s. The analysis is 3.7x the limit it is given, so the timeout was
# not a slow machine on a bad day — cold could never pass. The red said nothing about the
# code, and it is not a rare state: step 1's dependency-integrity lint drops build/phpstan
# whenever composer.lock moves, and a fresh clone has no result cache at all. The release
# gate could not pass on a clone that had never run it.
#
# The two shortcuts are both worse. `composer config process-timeout 0` writes the
# developer's GLOBAL config, so green would depend on machine state no clone carries;
# COMPOSER_PROCESS_TIMEOUT depends on every future caller remembering it. Calling the
# binary is what the other fifteen steps already do (pest, immediately above), and it has
# no timeout of its own — PHPStan's only timeout is `parallel: processTimeout: 600.0`,
# which bounds a worker process, not the run.
#
# THE ARGUMENTS ARE THE COMPOSER SCRIPT'S, VERBATIM: `phpstan analyse --no-progress
# --memory-limit=1G`. Level, paths, baseline and tmpDir still come from phpstan.neon by
# auto-discovery from the repo root this script cd's to near the top — the same cwd
# Composer ran the script in. Nothing about what is checked changed. Do not add or drop a
# flag here without changing composer.json's `analyse` script, which is KEPT: lint.yml,
# CONTRIBUTING.md and CLAUDE.md all still name it.
#
# So this is a DELIBERATE divergence from lint.yml's mirror (see the header): same binary,
# same arguments, same config, different wrapper. Do not "restore" it.
check "larastan" ./vendor/bin/phpstan analyse --no-progress --memory-limit=1G

# 16. Full suite + failure ratchet. Pest is allowed to "fail" (the baseline is
#     non-empty); the ratchet script is the gate, exactly as in tests.yml.
#
#     THE ARTEFACTS ARE KEPT PER RUN, and that is not housekeeping — it is the difference
#     between a nondeterministic failure being diagnosable and not. Both files used to be
#     written to a FIXED path, so every run destroyed the previous run's evidence. On
#     2026-08-09 this gate produced PASS, then FAIL with 23 unrelated permission/seed
#     failures, then PASS again on byte-identical code; by the time the third run finished,
#     the second run's messages were gone and only the ratchet's list of test NAMES survived.
#     Four hypotheses were then built on names and ordering alone and three were disproven —
#     the fourth could not be tested at all, because a suite failure cannot be diagnosed from
#     the names of the tests that failed. Eleven further runs did not reproduce it.
#
#     A gate that overwrites the record of its own red is a gate whose reds can only be
#     retried, never investigated. Runs are stamped and the last 20 kept, so the next
#     occurrence is still on disk whenever anyone notices it.
QUALITY_ARTEFACTS="${TMPDIR:-/tmp}/quality-runs"
mkdir -p "$QUALITY_ARTEFACTS"
QUALITY_RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
QUALITY_JUNIT="$QUALITY_ARTEFACTS/junit-$QUALITY_RUN_ID.xml"
QUALITY_LOG="$QUALITY_ARTEFACTS/pest-$QUALITY_RUN_ID.log"

step "tests (failure ratchet vs tests/ratchet-baseline.txt)"
env DB_DATABASE=portal_testing ./vendor/bin/pest --log-junit "$QUALITY_JUNIT" >"$QUALITY_LOG" 2>&1 || true

# The fixed paths stay as symlinks: bin/ci-test-ratchet.php, the docs and everyone's muscle
# memory refer to them, and "the latest run" is the common case. The per-run copy is what
# survives the NEXT run.
ln -sf "$QUALITY_JUNIT" /tmp/quality-junit.xml
ln -sf "$QUALITY_LOG" /tmp/quality-pest.log

# Bounded so this cannot grow without limit on a machine that runs the hook all day.
ls -1t "$QUALITY_ARTEFACTS"/junit-*.xml 2>/dev/null | tail -n +21 | xargs -r rm -f
ls -1t "$QUALITY_ARTEFACTS"/pest-*.log 2>/dev/null | tail -n +21 | xargs -r rm -f

check "test-ratchet" php bin/ci-test-ratchet.php "$QUALITY_JUNIT"

# 17. JavaScript tests (vitest). The first step in this gate that EXECUTES a line of
#     application JavaScript. Four steps above read resources/js — Prettier/ESLint see
#     style, tsc sees types, the vite build sees that it parses — and not one of them can
#     tell a correct function from a wrong one. 63k lines of hand-written TS/TSX had no
#     runner that could assert a single behaviour; the money boundary in
#     resources/js/lib/format.ts is exempted from the money lint on review alone, which is
#     the surface that most deserved one. docs/handoff/tickets/no-javascript-test-runner.md.
#
#     NOT RATCHETED, unlike tsc and the Pest suite. Both of those are baselined because they
#     inherited failures that predate the gate; this starts at zero and stays at zero. A
#     green here is "every JavaScript test passes", with no baseline to be behind — the
#     claim the tsc ratchet structurally cannot make. If that ever has to change, it is a
#     decision to record, not a default to slide into.
#
#     IT IS LAST, AND THAT IS A COST, STATED. It runs in about a second, so on feedback
#     alone it belongs beside the other resources/js steps at 4-5; a JS red is now found
#     after the ~6-minute suite. It sits here because inserting a step mid-list renumbers
#     every `step N` in this file AND five `bin/quality:LINE` citations in tests/ and
#     .claude/skills/ that no lint can fail on (they are baselined, so they would go stale
#     SILENTLY) — prose the QualityStepCountTest docblock says outright must be moved by
#     hand. Appending moves none of it. Reordering is a clean mechanical change on its own
#     branch, and this comment is the note that it is worth doing.
step "javascript tests (vitest — the only step that executes application JS)"
check "vitest" pnpm run test:js

# ---------------------------------------------------------------------- verdict
echo
if [ ${#FAILED[@]} -eq 0 ]; then
    printf '%s✓ quality: PASS%s — per-push floor. Promoting to main? run bin/quality-promote.\n' "$GREEN" "$OFF"
    exit 0
fi

printf '%s✗ quality: FAIL%s (%d): %s\n' "$RED" "$OFF" "${#FAILED[@]}" "${FAILED[*]}"
printf '%sPush blocked. Fix the above, or bypass deliberately with --no-verify (recorded as intent, not accident).%s\n' "$DIM" "$OFF"

# WHERE THE EVIDENCE IS, printed on the red rather than left to be rediscovered. This gate has
# produced a red that vanished before anyone could read it (see step 16). If this failure is one
# you cannot explain, these two files are the only record of it and the NEXT run no longer
# overwrites them — copy them somewhere before doing anything else.
if [ -n "${QUALITY_LOG:-}" ] && [ -f "$QUALITY_LOG" ]; then
    printf '%sThis run'"'"'s suite output: %s%s\n' "$DIM" "$QUALITY_LOG" "$OFF"
    printf '%sThis run'"'"'s junit:        %s%s\n' "$DIM" "$QUALITY_JUNIT" "$OFF"
    printf '%sKept for the last 20 runs. A red you cannot reproduce is only diagnosable from these.%s\n' "$DIM" "$OFF"
fi

exit 1
